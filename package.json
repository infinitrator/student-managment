{
  "name": "student-managment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css && npm run format:check",
    "lint:js": "eslint js tests",
    "lint:html": "html-validate \"*.html\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "test": "node --test"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "64.3.3",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.12.0",
    "html-validate": "11.11.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0"
  }
}
